---
import "../styles/global.css";
import ornament from "../images/ornament.png";
import main_image from "../images/main-image.jpg";
import save_the_date from "../images/save-the-date.jpg";
---

<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=Inter:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <title>Svadba Teres a Adam</title>
  </head>
  <body>
    <!-- HEADER -->
    <header>
      <nav class="navbar">
        <div class="nav-inner">
          <div class="logo"><a href="#home">T&A</a></div>

          <button class="burger" id="burger">
            <span></span>
            <span></span>
            <span></span>
          </button>

          <ul class="nav-list" id="nav">
            <li><a href="#invitation">Pozvánka</a></li>
            <li><a href="#program">Program</a></li>
            <li><a href="#menu">Menu</a></li>
            <li><a href="#drink-menu">Nápojový lístok</a></li>
            <li><a href="#info">Ďalšie informácie</a></li>
          </ul>
        </div>
      </nav>
    </header>

    <!-- MAIN -->
    <main>
      <!-- HOME -->
      <section id="home" class="hero">
        <img src={main_image.src} class="main-image" alt="main-image" />
        <img
          src={save_the_date.src}
          class="save-the-date-image"
          alt="save-the-date"
        />
      </section>

      <!-- INVITATION -->
      <section id="invitation" class="hero">
        <h2>S RADOSŤOU VÁM OZNAMUJEME,</h2>
        <h2>ŽE SME SA ROZHODLI SPOJIŤ SVOJE ŽIVOTY.</h2>
        <img src={ornament.src} class="hero-image" alt="ornament" />
        <h1>ADAM ZVERBÍK</h1>
        <h1>&</h1>
        <h1>TERÉZIA IKRÉNYIOVÁ</h1>
        <h3>12 SEPTEMBER 2026</h3>
        <h3>SOBOTA 15:30</h3>
        <h3>
          <a
            class="link"
            href="https://new.castelmierovo.sk/kontakt"
            target="_blank">CASTEL MIEROVO</a
          >
        </h3>
      </section>

      <!-- PROGRAM -->
      <section id="program" class="card-wrapper">
        <div class="card">
          <h1>PROGRAM</h1>

          <div class="section">
            <p>15:00 - Príchod, welcome drink a snack</p>
            <p>15:30- Obrad, gratulácie, fotenie skupín</p>
            <p>16:45 - Slávnostná večera</p>
            <p>18:00 - Prvý tanec</p>
            <p>18:30 - Candy bar a kávička, fotokútik</p>
            <p>20:30 - Prskavkové fotenie a krájanie torty</p>
            <p>
              21:30 - Druhá večera - švédske stoly; Zábava až do rána (3:00)
            </p>
          </div>
        </div>
      </section>

      <!-- MENU -->
      <section id="menu" class="card-wrapper">
        <div class="card">
          <h1>MENU</h1>
          <h2>Aperitív</h2>
          <p>Prosecco Rebuli Brut Treviso DOC</p>
          <h2>Polievka</h2>
          <p>
            Kurací vývar, trhané mäso, koreňová zelenina, rezance od babičky
          </p>
          <h2>Hlavné jedlo</h2>
          <p>
            Panenka Mediterranea (plnka z prosciutta, mozzarelly a sušených
            paradajok), krémové rizoto, pečený zemiak s rozmarínom, hnedá sauce,
            pečená koreňová zelenina
          </p>
          <p>
            Vegetariánska možnosť: grilovaná cuketová rolka plnená s vegan syrom
            a cherry paradajkami, zeleninový bulgur
          </p>
        </div>
      </section>

      <!-- DRINK MENU -->
      <section id="drink-menu" class="card-wrapper">
        <div class="card">
          <h1>NÁPOJOVÝ LÍSTOK</h1>
          <h2>Vínna Karta</h2>
          <p>Sauvignon Blanc, suché biele (Vinárstvo Dubicz)</p>
          <p>Tricollis, suché biele (Pannonhalmi Főapátság)</p>
          <p>Cabernet Sauvignon, polosladké ružové (Chateau Topoľčianky)</p>
          <h2>Destiláty a pivo</h2>
          <p>Čapované pivo (Pilsner Urquell)</p>
          <p>Domáca jabĺčkovica</p>
          <p>Gin (aj s tonikom)</p>
          <h2>Nealko</h2>
          <p>Kofola</p>
          <p>Vinea, biela</p>
          <p>Coca-Cola Zero</p>
        </div>
      </section>

      <!-- PHOTO -->
      <section id="photo" class="card-wrapper">
        <div class="card">
          <h1>FOTOGRAFIE</h1>
          <p>
            Fotografie odfotené na Váš telefón môžete prosím nahrať cez uvedený
            QR kód do nášho spoločného albumu. Ďakujeme.
          </p>
        </div>
      </section>

      <!-- ADDITIONAL INFORMATION -->
      <section id="info" class="card-wrapper">
        <div class="card">
          <h1>ĎAĽŠIE INFORMÁCIE</h1>

          <div class="section">
            <!-- VENUE -->
            <h2>Miesto konania</h2>
            <p>
              <a
                class="link"
                href="https://new.castelmierovo.sk/kontakt"
                target="_blank">Castel Mierovo</a
              >
            </p>
            <p>Mierovo 20</p>
            <p>930 41 Mierovo</p>
            <p>Slovenská republika</p>
          </div>
          <div class="section">
            <!-- CONTACT -->
            <h2>Kontaktná osoba</h2>
            <p>V deň svadby kontaktovať:</p>
            <p>Veronika (svedkyňa)</p>
            <p>+421 910 988 895</p>
          </div>
          <div class="section">
            <!-- GIFTS -->
            <h2>Informácie k darom</h2>
            <p>
              Ak by ste nás chceli poctiť svadobným darom, môžete nás obdarovať
              drobným finančným príspevkom na svadobnú cestu, či už do
              pokladničky priamo na mieste alebo na účet SK13 1100 0000 0029
              1766 8896. Najväčšiu radosť nám však urobí, keď v tento svadobný
              deň budeme spolu.
            </p>
          </div>

          <div class="section">
            <!-- +1 -->
            <h2>+1 Doprovod</h2>
            <p>
              Z kapacitných a finančných dôvodov nie je možné každému umožniť
              zobrať so sebou doprovod. Veríme, že sa aj tak zabavíte.
            </p>
          </div>

          <div class="section">
            <!-- POSSIBLE ACCOMODATION -->
            <h2>Možnosti ubytovania v okolí</h2>
            <div class="section">
              <p>
                1.
                <a
                  class="link"
                  href="https://www.booking.com/hotel/sk/luxury-private.sk.html?aid=1320040&label=pageearnpoints-ban-1320040-click&sid=8f73433a84a220058f104d45d3969856&all_sr_blocks=421056601_179416259_4_0_0&checkin=2026-09-12&checkout=2026-09-13&dest_id=-842355&dest_type=city&dist=0&group_adults=4&group_children=0&hapos=2&highlighted_blocks=421056601_179416259_4_0_0&hpos=2&matching_block_id=421056601_179416259_4_0_0&no_rooms=2&req_adults=4&req_children=0&room1=A%2CA&room2=A%2CA&sb_price_type=total&sr_order=popularity&sr_pri_blocks=421056601_179416259_4_0_0__10240&srepoch=1768155685&srpvid=8df88039072c055f&type=total&ucfs=1&#hotelTmpl"
                  target="_blank">Luxury apartment, Horná Potôň</a
                >
              </p>
              <p>Kapacita je pre 4 ľudí:</p>
              <p>
                Izba s manželskou posteľou, izba s 1 lôžkom, obývacia izba s 1
                lôžkom.
              </p>
              <p>
                Zarezervované do 27.8.2026. V prípade záujmu, nám treba dať
                vedieť.
              </p>
              <p>Vzdialenosť od miesta konania je približne 10 minút autom.</p>
              <p>Cena je 102€.</p>
            </div>
            <div class="section">
              <p>
                2.
                <a
                  class="link"
                  href="https://www.booking.com/hotel/sk/villa-poton.sk.html?aid=356938&label=metagha-link-MRSK-hotel-10917205_dev-desktop_los-1_bw-31_dow-Friday_defdate-1_room-0_gstadt-2_rateid-public_aud-0_gacid-21404706195_mcid-50_bc-AKaVVQ_ppa-0_clrid-0_ad-1_gstkid-0_checkin-20260123_ppt-B_lp-2703_r-14951315470286292280&sid=c5b33416d650aeee2fc40703ae04397d&all_sr_blocks=1091720501_382049937_2_1_0&checkin=2026-01-23&checkout=2026-01-24&dest_id=10917205&dest_type=hotel&dist=0&group_adults=2&group_children=0&hapos=1&highlighted_blocks=1091720501_382049937_2_1_0&hpos=1&matching_block_id=1091720501_382049937_2_1_0&no_rooms=1&req_adults=2&req_children=0&room1=A%2CA&sb_price_type=total&sr_order=popularity&sr_pri_blocks=1091720501_382049937_2_1_0__6751&srepoch=1766529384&srpvid=706e9ed66afb0216&type=total&ucfs=1"
                  target="_blank">Villa Potôň 2023, Horná Potôň</a
                >
              </p>
              <p>
                Ubytovanie ponúka 1-,2-lôžkové izby s raňajkami a parkovacím
                miestom.
              </p>
              <p>Izbu si musíte rezervovať samostatne.</p>
              <p>Vzdialenosť od miesta konania je približne 9 minút autom.</p>
            </div>
            <div class="section">
              <p>
                3.
                <a
                  class="link"
                  href="https://www.booking.com/hotel/sk/penzion-moto.sk.html?aid=356938&label=metagha-link-MRSK-hotel-10917205_dev-desktop_los-1_bw-31_dow-Friday_defdate-1_room-0_gstadt-2_rateid-public_aud-0_gacid-21404706195_mcid-50_bc-AKaVVQ_ppa-0_clrid-0_ad-1_gstkid-0_checkin-20260123_ppt-B_lp-2703_r-14951315470286292280&sid=c5b33416d650aeee2fc40703ae04397d&all_sr_blocks=569200503_262878078_2_1_0&checkin=2026-09-12&checkout=2026-09-13&dest_id=-842355&dest_type=city&dist=0&group_adults=2&group_children=0&hapos=4&highlighted_blocks=569200503_262878078_2_1_0&hpos=4&matching_block_id=569200503_262878078_2_1_0&no_rooms=1&req_adults=2&req_children=0&room1=A%2CA&sb_price_type=total&sr_order=popularity&sr_pri_blocks=569200503_262878078_2_1_0__7689&srepoch=1766531363&srpvid=97a9a2c450450262&type=total&ucfs=1&chal_t=1778331128095&force_referer="
                  target="_blank">Penzión Moto, Svätý Michal</a
                >
              </p>
              <p>Ubytovanie ponúka 2-,3-lôžkové izby s raňajkami.</p>
              <p>Izbu si musíte rezervovať samostatne.</p>
              <p>Vzdialenosť od miesta konania je približne 12 minút autom.</p>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const burger = document.getElementById("burger");
      const nav = document.getElementById("nav");

      const toggleMenu = () => {
        nav.classList.toggle("active");

        // lock scroll
        if (nav.classList.contains("active")) {
          document.body.style.overflow = "hidden";
        } else {
          document.body.style.overflow = "";
        }
      };

      const closeMenu = () => {
        nav.classList.remove("active");
        document.body.style.overflow = "";
      };

      // klik na burger
      burger?.addEventListener("click", toggleMenu);

      // klik na link
      document.querySelectorAll(".nav-list a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      // ESC key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeMenu();
        }
      });

      // klik mimo menu
      nav?.addEventListener("click", (e) => {
        if (e.target === nav) {
          closeMenu();
        }
      });
    });
  </script>
</html>
